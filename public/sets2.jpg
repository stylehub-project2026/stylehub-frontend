"Chance","Free":"Free","Gifts":"Gifts","two_chance_to_spin":"You have 2 chances to spin","one_more_chance_to_win":"1 more chance to win extra benefit!","for_specific_item":"For specific item","FREE":"FREE","GIFTS":"GIFTS","get_them_in_app":"Get them in App","free_gifts_included":"Free Gifts included","grand_opening":"Grand Opening","you_hit_the_big_time":"You hit the big time","you_are_the_lucky":"You're the lucky winner","congrats_big_win":"Congrats on the big win","you_nailed_it":"You nailed it","winner":"Winner winner","Type":"Type","exclusive_discount":"Exclusive discount","savings_card":"Savings Card","best_prize":"BEST PRIZE","jackpot_dont_miss":"Jackpot！Don't miss out","best_price_only":"Best price only for you","max_discount":"Max. discount","congrats_on_big_win":"Congrats on the big win","download_now":"Download now","download_temu":"Download Temu to get","save_big_in_app":"Save big in App","claim_prize_in_app":"Claim the prize in App","recent_viewed":"Recent viewed","in_cart":"In cart","great_discount_for_you":"Great discount for you","great_discount":"Great discount","your_cart":"Your Cart","benefitsForNewDownloads":"Benefits for new downloads","rolling_discount":"Rolling your special discount","drawing_discount":"Drawing your special discount","special_discount":"Special discount","appNewUsersGift":"App new user gift","two_prizes_available_in_app":"2 prizes available in App","good_luck":"Good Luck","credit":"Credit","cash":"Cash","more_chance":"more chance","drawing_your_prize":"Drawing your prize","dn5_title_1":"You got the best prize","dn5_title_2":"You got the best prize","dn5_title_3":"You got the best prize","dn5_title_4":"You got the best prize","dn5_title_5":"You got the best prize","dn5_btn_1":"Get it in App","dn5_btn_2":"Get it in App","dn5_btn_3":"Get it in App","dn5_btn_4":"Get it in App","recently_viewed":"Recently viewed","free-gifts-for-you":"Free Gifts for You","extra":"Extra","you_got_best_prize_exp1":"You got the best prize","you_got_bes